#!/usr/bin/env bash

set -euo pipefail

pkg="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$pkg/bin:${PATH:-}"
export PUB_CACHE="${PUB_CACHE:-$pkg/.pub-cache}"

code_file="$1"
shift || true

workdir=".piston-dart"
rm -rf "$workdir"
mkdir -p "$workdir"

shopt -s dotglob nullglob
for file in *; do
  if [ "$file" = "$workdir" ]; then
    continue
  fi
  cp -R "$file" "$workdir/"
done
shopt -u dotglob nullglob

cat > "$workdir/pubspec.yaml" <<'EOF'
name: piston_runtime
environment:
  sdk: ">=2.19.0 <3.0.0"
dependencies:
  collection: 1.18.0
EOF

(
  cd "$workdir"
  dart pub get --offline
  dart run "$(basename "$code_file")" "$@"
)
