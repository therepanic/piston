#!/usr/bin/env bash

# Put instructions to compile source code, remove this file if the language does not require this stage

set -euo pipefail


case "${PISTON_LANGUAGE}" in
    c)
        main_file="$1"
        mv "$main_file" "${main_file}.c"
        shift || true
        gcc -std=c11 "${main_file}.c" "$@" -lm
        ;;
    c++)
        main_file="$1"
        mv "$main_file" "${main_file}.cpp"
        shift || true
        g++ -std=c++17 -I"${PISTON_GCC_INCLUDE_DIR}" "${main_file}.cpp" "$@"
        ;;
    d)
        main_file="$1"
        mv "$main_file" "${main_file}.d"
        shift || true
        gdc "${main_file}.d" "$@"
        ;;
    fortran)
        main_file="$1"
        mv "$main_file" "${main_file}.f90"
        shift || true
        gfortran "${main_file}.f90" "$@"
        ;;
    *)
        echo "How did you get here? (${PISTON_LANGUAGE})"
        exit 1
        ;;
esac

if [ -f a.out ]; then
    chmod +x a.out
fi
