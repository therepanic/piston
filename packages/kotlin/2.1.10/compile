#!/usr/bin/env bash
set -euo pipefail

main_file="$1"
if [[ "$main_file" != *.kt ]]; then
  mv "$main_file" "${main_file}.kt"
fi

classpath=""
lib_dir="${PISTON_KOTLIN_LIB_DIR:-}"
if [ -z "$lib_dir" ] || [ ! -d "$lib_dir" ]; then
  lib_dir="libs"
fi

if [ -d "$lib_dir" ]; then
  for jar in "$lib_dir"/*.jar; do
    [ -e "$jar" ] || continue
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="${classpath}:$jar"
    fi
  done
fi

compile_args=( *.kt -include-runtime -d code.jar )
if [ -n "$classpath" ]; then
  compile_args=( -cp "$classpath" "${compile_args[@]}" )
fi

kotlinc "${compile_args[@]}"

if [ -d "$lib_dir" ]; then
  merge_dir="$(mktemp -d)"
  for jar in "$lib_dir"/*.jar; do
    [ -e "$jar" ] || continue
    (
      cd "$merge_dir"
      jar xf "$jar"
    )
  done
  rm -rf "$merge_dir/META-INF"
  if find "$merge_dir" -mindepth 1 -print -quit | grep -q .; then
    jar uf code.jar -C "$merge_dir" .
  fi
  rm -rf "$merge_dir"
fi

