#!/usr/bin/env bash
set -euo pipefail

pkgdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
main_file="$1"
shift || true

source_name="$main_file"
if [[ ! -e "$source_name" && "$source_name" != *.kt && -e "${source_name}.kt" ]]; then
  source_name="${source_name}.kt"
fi

if [[ ! -e "$source_name" ]]; then
  echo "main Kotlin file not found: $main_file" >&2
  exit 1
fi

rm -rf out

if [[ "$source_name" != "Main.kt" ]]; then
  mv "$source_name" Main.kt
fi

echo "MainKt" > .piston_main_class

classpath=""
lib_dir="${PISTON_KOTLIN_LIB_DIR:-}"
if [ -z "$lib_dir" ] || [ ! -d "$lib_dir" ]; then
  lib_dir="libs"
fi

if [ -d "$lib_dir" ]; then
  for jar in "$lib_dir"/*.jar; do
    [ -e "$jar" ] || continue
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="${classpath}:$jar"
    fi
  done
fi

compile_args=( -Xbackend-threads=1 -d out )
if [ -n "$classpath" ]; then
  compile_args=( -cp "$classpath" "${compile_args[@]}" )
fi

kotlinc \
  -J-XX:+UseSerialGC \
  -J-XX:TieredStopAtLevel=1 \
  -J-Xms32m \
  -J-Xmx256m \
  "${compile_args[@]}" \
  *.kt

