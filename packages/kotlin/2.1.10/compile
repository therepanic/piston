#!/usr/bin/env bash
set -euo pipefail

pkgdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
main_file="$1"
main_name="$(basename "$main_file")"
shift || true

workdir=".piston-kotlin"
rm -rf "$workdir"
mkdir -p "$workdir"

shopt -s dotglob nullglob
for file in *; do
  if [[ "$file" == "$workdir" ]]; then
    continue
  fi
  cp -R "$file" "$workdir/"
done
shopt -u dotglob nullglob

source_name="$main_name"
if [[ ! -e "$workdir/$source_name" && "$source_name" != *.kt && -e "$workdir/${source_name}.kt" ]]; then
  source_name="${source_name}.kt"
fi

if [[ ! -e "$workdir/$source_name" ]]; then
  echo "main Kotlin file not found in $workdir: $main_name" >&2
  exit 1
fi

if [[ "$source_name" != "Main.kt" ]]; then
  mv "$workdir/$source_name" "$workdir/Main.kt"
fi

echo "MainKt" > .piston_main_class

classpath=""
lib_dir="${PISTON_KOTLIN_LIB_DIR:-}"
if [ -z "$lib_dir" ] || [ ! -d "$lib_dir" ]; then
  lib_dir="libs"
fi

stdlib_dir="${pkgdir}/lib"

if [ -d "$lib_dir" ]; then
  for jar in "$lib_dir"/*.jar; do
    [ -e "$jar" ] || continue
    if [ -z "$classpath" ]; then
      classpath="$jar"
    else
      classpath="${classpath}:$jar"
    fi
  done
fi

for jar in "$stdlib_dir"/*.jar; do
  [ -e "$jar" ] || continue
  if [ -z "$classpath" ]; then
    classpath="$jar"
  else
    classpath="${classpath}:$jar"
  fi
done

compile_args=( -Xbackend-threads=1 -d out )
if [ -n "$classpath" ]; then
  compile_args=( -cp "$classpath" "${compile_args[@]}" )
fi

(
  cd "$workdir"
  kotlinc "${compile_args[@]}" *.kt
)

