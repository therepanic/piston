#!/bin/bash

set -euo pipefail

pkg="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

rename_if_missing_extension() {
    local ext="$1"
    shift || true
    local file

    for file in "$@"; do
        if [[ "$file" != *.* ]]; then
            mv "$file" "${file}.${ext}"
        fi
    done
}

find_shell_cmd() {
    local cmd
    for cmd in "$@"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '%s\n' "$cmd"
            return 0
        fi
    done
    return 1
}

find_compiler_exe() {
    local exe
    for exe in \
        "$pkg/lib/mono/4.5/mcs.exe" \
        "$pkg/lib/mono/4.5/csc.exe" \
        "$pkg/lib/mono/4.5/basic.exe"
    do
        if [ -f "$exe" ]; then
            printf '%s\n' "$exe"
            return 0
        fi
    done
    return 1
}

case "${PISTON_LANGUAGE}" in
    csharp)
        rename_if_missing_extension cs "$@"
        if CSC="$(find_shell_cmd mono-csc mcs csc)"; then
            "$CSC" -out:out.exe *.cs
        elif CSC_EXE="$(find_compiler_exe)"; then
            mono "$CSC_EXE" -out:out.exe *.cs
        else
            echo "No C# compiler found (tried: mono-csc, mcs, csc, lib/mono/4.5/{mcs,csc}.exe)" >&2
            exit 1
        fi
        ;;
    basic)
        rename_if_missing_extension vb "$@"
        if VBNC="$(find_shell_cmd vbnc)"; then
            "$VBNC" -out:out.exe *.vb
        elif [ -f "$pkg/lib/mono/4.5/vbnc.exe" ]; then
            mono "$pkg/lib/mono/4.5/vbnc.exe" -out:out.exe *.vb
        else
            echo "No Visual Basic compiler found (tried: vbnc, lib/mono/4.5/vbnc.exe)" >&2
            exit 1
        fi
        ;;
    *)
        echo "How did you get here? (${PISTON_LANGUAGE})"
        exit 1
        ;;
esac
