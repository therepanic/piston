#!/usr/bin/env bash
set -euo pipefail

pkgdir="$(cd "$(dirname "$0")" && pwd)"
mv "$1" "$1.swift"
main_file="$1.swift"
shift || true

if ! grep -Eq '^[[:space:]]*import[[:space:]]+(Algorithms|Collections|Numerics)\b' "$main_file"; then
    swiftc "$main_file" -o ./binary
    chmod +x ./binary
    exit 0
fi

template_dir="$pkgdir/template-swiftpm"
build_root="$template_dir/.build"
triple_dir="$(find "$build_root" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
release_dir=""

if [ -n "$triple_dir" ] && [ -d "$triple_dir/release" ]; then
    release_dir="$triple_dir/release"
elif [ -d "$build_root/release" ]; then
    release_dir="$build_root/release"
fi

if [ -z "$release_dir" ] || [ ! -d "$release_dir" ]; then
    echo "missing prebuilt Swift release artifacts under $build_root" >&2
    exit 1
fi

include_flags=(
    -I "$release_dir/Modules"
    -I "$release_dir"
)

while IFS= read -r dir; do
    include_flags+=( -I "$dir" )
done < <(find "$build_root" -type f -name module.modulemap -printf '%h\n' | sort -u)

swiftc "$main_file" \
    "${include_flags[@]}" \
    -L "$release_dir" \
    -Xlinker -rpath -Xlinker "$release_dir" \
    -lAlgorithms \
    -lCollections \
    -lNumerics \
    -o ./binary

chmod +x ./binary
